{
    "name": "fassa-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "FASSA UI Monorepo - Faculty of Science Student Association Portal",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "dev:tech": "pnpm --filter fassa-tech dev",
        "dev:web": "pnpm --filter fassa-web dev",
        "dev:all": "turbo run dev --parallel",
        "clean": "turbo run clean && rm -rf node_modules",
        "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
    },
    "devDependencies": {
        "turbo": "^2.3.3",
        "typescript": "^5.7.3",
        "prettier": "^3.4.2"
    },
    "packageManager": "pnpm@9.15.4",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=9.0.0"
    }
}